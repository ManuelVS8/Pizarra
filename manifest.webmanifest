{
  "name": "Pizarra Siurot",
  "short_name": "Pizarra",
  "description": "Pizarra digital para PDI y paneles interactivos: escribe sobre páginas, PDF e imágenes.",
  "id": "./pizarra.html",
  "start_url": "./pizarra.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "lang": "es",
  "dir": "ltr",
  "background_color": "#1F4036",
  "theme_color": "#1F4036",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "icono-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Nuevo rotafolio", "short_name": "Nuevo", "url": "./pizarra.html?nuevo", "icons": [{ "src": "icono-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "file_handlers": [
    { "action": "./pizarra.html", "accept": { "application/x-pizarra": [".pizarra"], "application/pdf": [".pdf"] } }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
